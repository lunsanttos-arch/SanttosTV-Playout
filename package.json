{
  "name": "santtos-tv-playout",
  "version": "0.3.0-rc.1",
  "description": "Sistema profissional de automação e playout de TV",
  "main": "src/main/main.js",
  "author": "Santtos TV",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:test": "node scripts/start-testbench.js",
    "dev:ndi-test": "node scripts/start-ndi-testbench.js",
    "check:ndi": "node scripts/check-ndi-audio.js",
    "start": "npm run dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && node scripts/check-native-runtime.js && electron-builder",
    "test:backend": "node scripts/test-backend.js",
    "test:security": "node scripts/test-security.js",
    "test:testbench": "node scripts/test-testbench.js",
    "test:media-stream": "node scripts/test-media-stream.js",
    "test:proxy": "node scripts/test-preview-proxy.js",
    "test:web-input": "node scripts/test-web-input-playback.js && node scripts/test-loopback-input.js",
    "test:vlc-input": "node scripts/test-vlc-input-bridge.js",
    "test:exhibition-output": "node scripts/test-exhibition-output.js",
    "test:timeline-forecast": "node scripts/test-timeline-forecast.js",
    "test:output-profile": "node scripts/test-output-profile.js",
    "test:playout-engine": "node scripts/test-playout-engine.js",
    "test:ndi-audio": "node scripts/test-ndi-audio.js && node scripts/test-ndi-pipe.js && node scripts/test-ndi-native-audio.js",
    "test:ndi-video": "node scripts/test-ndi-frame-aligner.js",
    "test:frontend": "npm exec tsc -- --noEmit && npm run build:renderer && node scripts/test-frontend.js",
    "test": "npm run test:security && npm run test:media-stream && npm run test:proxy && npm run test:web-input && npm run test:warm-input && npm run test:input-prebuffer && npm run test:vlc-input && npm run test:exhibition-output && npm run test:timeline-forecast && npm run test:output-profile && npm run test:playout-engine && npm run test:ndi-audio && npm run test:program-audio-monitor && npm run test:program-preview-tap && npm run test:ndi-video && npm run test:omt && npm run test:server-media && npm run test:testbench && npm run test:backend && npm run test:recovery && npm run test:video-clocked-pcm && npm run test:frontend && npm run test:controller && npm run test:reports && npm run test:transports && npm run test:frame-pacer && npm run test:input-deadline && npm run test:live-graphics && npm run test:rundown-blocks && npm run test:data-backup && npm run test:rundown-controller && npm run test:watchdog && npm run test:diagnostics && npm run test:media-runtime && npm run test:program-standby && npm run test:program-audio-router && npm run test:rundown-export && npm run test:content-label",
    "stress:smoke": "node scripts/stress-playout.js smoke",
    "stress:quick": "node scripts/stress-playout.js quick",
    "stress:day": "node scripts/stress-playout.js day",
    "stress:72h": "node scripts/stress-playout.js 72h",
    "stress:large": "node scripts/stress-playout.js large",
    "predev": "npm run build:renderer && node scripts/check-dev-ndi.js",
    "predev:ndi-test": "npm run build:renderer && node scripts/check-dev-ndi.js",
    "prebuild": "scripts\\build-ndi.cmd",
    "test:input-prebuffer": "node scripts/test-input-prebuffer.js",
    "test:program-audio-monitor": "node scripts/test-program-audio-monitor.js",
    "test:program-preview-tap": "node scripts/test-program-preview-tap.js",
    "test:omt": "node scripts/test-omt-output.js",
    "test:server-media": "node scripts/test-server-media.js",
    "test:recovery": "node scripts/test-playout-recovery.js && node scripts/test-checkpoint-async.js && node scripts/test-persistence.js && node scripts/test-persistence-integration.js",
    "test:video-clocked-pcm": "node scripts/test-video-clocked-pcm.js",
    "test:warm-input": "node scripts/test-warm-input-tuner.js",
    "test:controller": "node scripts/test-scheduling-controller.js",
    "test:reports": "node scripts/test-readable-reports.js",
    "test:transports": "node scripts/test-transport-output.js",
    "test:frame-pacer": "node scripts/test-frame-pacer.js",
    "test:input-deadline": "node scripts/test-input-deadline.js",
    "test:live-graphics": "node scripts/test-live-graphics.js",
    "test:rundown-blocks": "node scripts/test-rundown-blocks.js",
    "test:data-backup": "node scripts/test-data-backup.js",
    "test:rundown-controller": "node scripts/test-rundown-controller.js && node scripts/test-rundown-resilience.js && node scripts/test-deck-preparer.js && node scripts/test-decoder-deck.js && node scripts/test-program-service.js && node scripts/test-monitor-delivery.js && node scripts/test-preview-isolation.js && node scripts/test-video-pipe-writer.js",
    "test:watchdog": "node scripts/test-process-watchdog.js",
    "test:diagnostics": "node scripts/test-diagnostic-redaction.js",
    "burn-in": "node scripts/burn-in-program.cjs",
    "test:program-autonomy": "node scripts/test-program-autonomy.cjs",
    "test:native-integration": "npm run build:renderer && node scripts/run-native-qa.cjs",
    "test:media-runtime": "node scripts/test-media-runtime.js",
    "test:program-standby": "node scripts/test-program-standby.js",
    "test:program-audio-router": "node scripts/test-program-audio-router.js",
    "test:rundown-export": "node scripts/test-rundown-pdf.js",
    "test:content-label": "node scripts/test-content-label.js"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "26.17.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.santtos.tvautomation",
    "productName": "SanTTos Playout",
    "extraResources": [
      {
        "from": "src/core/ndi",
        "to": "ndi",
        "filter": [
          "ndi_test.exe",
          "Processing.NDI.Lib.x64.dll"
        ]
      },
      {
        "from": "src/core/omt",
        "to": "omt",
        "filter": [
          "omt_sender.exe",
          "libomt.dll",
          "libvmx.dll"
        ]
      },
      {
        "from": "build-resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build-resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "src/core/runtime",
        "to": "runtime",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "manifest.json",
          "LICENSE*",
          "SOURCE*",
          "README.md"
        ]
      }
    ],
    "directories": {
      "output": "build",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/core/**/*",
      "src/database/**/*",
      "package.json",
      "!src/core/runtime/*.exe",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.exe",
      "!node_modules/@derhuerst/ffprobe-static/bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "executableName": "SanttosTVAutomation",
      "artifactName": "Santtos-Playout-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SanTTos Playout",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  },
  "allowScripts": {
    "@derhuerst/ffprobe-static@5.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "electron@44.7.2": true
  },
  "overrides": {
    "glob": {
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "readdir-glob": {
      "minimatch": {
        "brace-expansion": "2.1.7"
      }
    },
    "uuid": "11.1.1"
  }
}
