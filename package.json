{
  "name": "santtos-tv-playout",
  "version": "0.2.0",
  "description": "Sistema profissional de automação e playout de TV",
  "main": "src/main/main.js",
  "author": "Santtos TV",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && node scripts/check-native-runtime.js && electron-builder",
    "test:backend": "node scripts/test-backend.js",
    "test:security": "node scripts/test-security.js",
    "test:frontend": "npm exec tsc -- --noEmit && npm run build:renderer && node scripts/test-frontend.js",
    "test": "npm run test:security && npm run test:backend && npm run test:frontend",
    "stress:smoke": "node scripts/stress-playout.js smoke",
    "stress:quick": "node scripts/stress-playout.js quick",
    "stress:day": "node scripts/stress-playout.js day",
    "stress:72h": "node scripts/stress-playout.js 72h",
    "stress:large": "node scripts/stress-playout.js large"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.santtos.tvautomation",
    "productName": "Santtos TV Automation",
    "extraResources": [
      {
        "from": "src/core/ndi",
        "to": "ndi",
        "filter": ["ndi_test.exe", "Processing.NDI.Lib.x64.dll"]
      }
    ],
    "asarUnpack": [
      "node_modules/@derhuerst/ffprobe-static/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@derhuerst/ffprobe-static/**/*"
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/core/**/*",
      "src/database/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
