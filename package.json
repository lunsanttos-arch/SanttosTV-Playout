{
  "name": "santtos-tv-playout",
  "version": "0.2.0",
  "description": "Sistema profissional de automação e playout de TV",
  "main": "src/main/main.js",
  "author": "Santtos TV",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.santtos.tvautomation",
    "productName": "Santtos TV Automation",
    "asarUnpack": [
      "node_modules/@derhuerst/ffprobe-static/**/*"
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/core/**/*",
      "src/database/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
